      "content": "<style>\n.aiv-social-box{box-sizing:border-box;position:relative;overflow:hidden;padding:22px;border-radius:20px;background:linear-gradient(130deg,#071a36,#13396b);color:white;box-shadow:0 12px 30px #051d4030;font-family:inherit}\n.aiv-social-box *{box-sizing:border-box}\n.aiv-social-box:before{content:\"\";position:absolute;right:-65px;top:-75px;width:230px;height:230px;border-radius:50%;background:radial-gradient(circle,#20aaff55,transparent 70%);pointer-events:none}\n.aiv-social-head{position:relative;margin-bottom:18px}\n.aiv-social-kicker{display:block;font-size:11px;font-weight:800;letter-spacing:.12em;color:#77ddff;margin-bottom:6px}\n.aiv-social-head h3{font-size:25px!important;line-height:1.2!important;color:#fff!important;margin:0 0 7px!important;text-transform:none!important}\n.aiv-social-head p{color:#d4e9ff;font-size:13px;margin:0!important}\n.aiv-social-btn{position:relative;display:flex!important;align-items:center;gap:15px;min-height:84px;padding:14px 16px;margin-top:12px;border:1px solid #ffffff50;border-radius:15px;color:#fff!important;text-decoration:none!important;transition:transform .2s,box-shadow .2s,filter .2s}\n.aiv-social-btn.fb{background:linear-gradient(105deg,#144abf,#2585ff)}\n.aiv-social-btn.tg{background:linear-gradient(105deg,#0877a8,#12b9ed)}\n.aiv-social-btn svg{width:45px;height:45px;flex:none;fill:currentColor}\n.aiv-social-name{display:flex;flex-direction:column;gap:3px;min-width:0}\n.aiv-social-name strong{font-size:20px;color:#fff}\n.aiv-social-name small{font-size:11px;color:#e7f6ff}\n.aiv-social-arrow{margin-left:auto;font-size:24px;color:white}\n.aiv-social-btn:hover,.aiv-social-btn:focus-visible{transform:translateY(-3px);filter:brightness(1.1);box-shadow:0 8px 20px #0005}\n.aiv-social-btn:focus-visible{outline:3px solid #fff;outline-offset:2px}\n@media(prefers-reduced-motion:reduce){.aiv-social-btn{transition:none}.aiv-social-btn:hover{transform:none}}\n</style>\n<div class=\"aiv-social-box\" aria-label=\"Seguici sui social\">\n  <div class=\"aiv-social-head\">\n    <span class=\"aiv-social-kicker\">LA COMMUNITY DI AIVISION</span>\n    <h3>Seguici sui social</h3>\n    <p>Le novità sull'intelligenza artificiale, ogni giorno.</p>\n  </div>\n  <a class=\"aiv-social-btn fb\" href=\"https://www.facebook.com/share/1EjXMnhx7D/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Seguici su Facebook\">\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.88 3.77-3.88 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12Z\"/></svg>\n    <span class=\"aiv-social-name\"><strong>Facebook</strong><small>Seguici e commenta le notizie</small></span><span class=\"aiv-social-arrow\" aria-hidden=\"true\">↗</span>\n  </a>\n  <a class=\"aiv-social-btn tg\" href=\"https://t.me/aivision_tech\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Seguici su Telegram\">\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M21.5 3.5 2.9 10.7c-1.27.51-1.26 1.23-.23 1.55l4.78 1.49 1.85 5.76c.23.63.12.88.78.88.51 0 .74-.23 1.03-.51l2.49-2.42 5.18 3.83c.95.52 1.63.25 1.87-.88l3.16-14.91c.35-1.38-.53-2-1.41-1.59ZM8.2 13.39 18.97 6.6c.54-.33 1.03-.15.63.2l-8.92 8.05-.35 3.76-2.13-5.22Z\"/></svg>\n    <span class=\"aiv-social-name\"><strong>Telegram</strong><small>Ricevi gli aggiornamenti sul canale</small></span><span class=\"aiv-social-arrow\" aria-hidden=\"true\">↗</span>\n  </a>\n</div>"
    }
